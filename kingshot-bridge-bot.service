[Unit]
Description=Kingshot Discord Telegram Bridge Bot
After=network.target

[Service]
Type=simple
User=knycat
Group=knycat
WorkingDirectory=/home/knycat/kingshot-bot
EnvironmentFile=/home/knycat/kingshot-bot/.env
ExecStart=/home/knycat/kingshot-bot/venv/bin/python /home/knycat/kingshot-bot/bridge_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
